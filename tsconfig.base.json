{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    /* ============ базовые параметры ============ */
    "target": "ES2022",
    "lib": ["DOM", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "allowJs": false,
    "strict": true,
    "skipLibCheck": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@ui": ["./packages/ui"],
      "@contracts": ["./packages/contracts"],
      "@config-runtime": ["./packages/config-runtime"],
      "@api-client": ["./packages/api-client"],
      "@mixin": ["./apps/shell-react/src/shared/config/styles/mixin.scss"]
    },

    "rootDir": ".",
    "outDir": "dist-types"
  },

  "include": ["apps", "packages"],
  "exclude": ["node_modules", "dist", ".turbo"]
}
