{
  "name": "@codentia/shell-react",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rsbuild build",
    "dev": "cross-env NODE_OPTIONS=\"--experimental-vm-modules\" node ./server.mjs",
    "preview": "node ./prod-server.mjs",
    "lint": "pnpm exec eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "pnpm exec eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "format": "pnpm exec prettier . --check",
    "format:fix": "pnpm exec prettier . --write",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@api-client": "workspace:*",
    "@config-runtime": "workspace:*",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-query": "^5.90.5",
    "@types/react-router-dom": "^5.3.3",
    "@ui": "workspace:*",
    "framer-motion": "^12.23.26",
    "nanoid": "^5.1.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-dropzone": "^14.3.8",
    "react-markdown": "^10.1.0",
    "react-router": "^7.9.4",
    "react-router-dom": "^7.9.4",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@api-client": "workspace:*",
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@eslint/js": "^9.33.0",
    "@module-federation/rsbuild-plugin": "^0.19.1",
    "@module-federation/typescript": "^3.1.5",
    "@rsbuild/core": "^1.5.10",
    "@rsbuild/plugin-react": "1.4.0",
    "@rsbuild/plugin-sass": "^1.4.0",
    "@rsbuild/plugin-svgr": "^1.2.2",
    "@types/express": "^5.0.3",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@ui": "workspace:*",
    "cross-env": "^10.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "express": "^5.1.0",
    "globals": "^16.3.0",
    "postcss-scss": "^4.0.9",
    "stylelint": "^16.23.1",
    "stylelint-config-prettier": "^9.0.5",
    "stylelint-config-standard-scss": "^15.0.1",
    "stylelint-scss": "^6.12.1",
    "typescript-eslint": "^8.39.1"
  }
}
