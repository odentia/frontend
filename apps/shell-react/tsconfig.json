{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["DOM", "ES2020"],
    "module": "ESNext",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "moduleResolution": "bundler",
    "types": ["@rsbuild/core/types"],
    "plugins": [
      {
        "name": "@module-federation/typescript",
        "remotes": [
          {
            "name": "auth",
            "entry": "auth@http://localhost:3010/remoteEntry.js"
          }
        ]
      }
    ]
  },
  "include": ["src"]
}
